        "description": "VS330 is a LoRaWAN® bathroom occupancy sensor providing a cost-effective solution for monitoring the occupancy status of the bathrooms and the cubicles of a public toilet in different scenarios.",
        "enabled": true,
        "name": "Milesight-Iot VS330",
        "product": "milesight_iot_vs330",
        "profile": {
          "api": {
            "downlink": {
              "enabled": true,
              "handle_connectivity": false,
              "request": {
                "data": {
                  "path": "/downlink",
                  "payload": "{\r\n    \"data\"    : \"{{payload.data=\"\"}}\",\r\n    \"port\"    :  {{payload.port=2}},\r\n    \"priority\":  {{payload.priority=3}},\r\n    \"confirmed\" :  {{payload.confirmed=false}},\r\n    \"uplink\"  :  {{property.uplink}} \r\n}",
                  "payload_function": "",
                  "payload_type": "",
                  "plugin": "{{property.uplink.source}}",
                  "target": "plugin_endpoint"
