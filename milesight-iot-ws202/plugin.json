        "description": "LoRaWAN PIR motion sensor detecting occupancy within 6-8m range. Features integrated light sensor for scene triggering. Battery-powered with compact design for easy installation anywhere. Ideal for smart building automation and occupancy monitoring.",
        "enabled": true,
        "name": "Milesight-Iot WS202",
        "product": "milesight_iot_ws202",
        "profile": {
          "api": {
            "downlink": {
              "enabled": true,
              "handle_connectivity": false,
              "request": {
                "data": {
                  "path": "/downlink",
                  "payload": "{\r\n    \"data\"    : \"{{payload.data=\"\"}}\",\r\n    \"port\"    :  {{payload.port=2}},\r\n    \"priority\":  {{payload.priority=3}},\r\n    \"confirmed\" :  {{payload.confirmed=false}},\r\n    \"uplink\"  :  {{property.uplink}} \r\n}",
                  "payload_function": "",
                  "payload_type": "",
