                          "template": "<div style=\"width:100%; height:100%; overflow-y:auto; padding:10px;\">\n  <table class=\"table table-striped table-condensed\">\n    <thead>\n      <tr>\n        <th style=\"width:40%\">Timestamp</th>\n        <th style=\"width:30%\">Button Event</th>\n        <th style=\"width:15%\">Battery (%)</th>\n        <th style=\"width:15%\">Message ID</th>\n      </tr>\n    </thead>\n    <tbody>\n      <tr ng-repeat=\"entry in value\" ng-if=\"entry.button_status\">\n        <td>{{ entry.ts | date:'dd/MM/yyyy HH:mm:ss' }}</td>\n        <td>\n          <span ng-if=\"entry.button_status === 'short press'\" style=\"padding:4px 8px; background-color:#2ecc71; color:#fff; border-radius:4px; font-size:12px;\">\n            Short Press\n          </span>\n          <span ng-if=\"entry.button_status === 'long press'\" style=\"padding:4px 8px; background-color:#f1c40f; color:#fff; border-radius:4px; font-size:12px;\">\n            Long Press\n          </span>\n          <span ng-if=\"entry.button_status === 'double press'\" style=\"padding:4px 8px; background-color:#e74c3c; color:#fff; border-radius:4px; font-size:12px;\">\n            Double Press\n          </span>\n        </td>\n        <td>{{ entry.battery || '—' }}</td>\n        <td>{{ entry.msgid || '—' }}</td>\n      </tr>\n      <tr ng-if=\"value.length === 0\">\n        <td colspan=\"4\" style=\"text-align:center; padding:20px;\">No button events recorded</td>\n      </tr>\n    </tbody>\n  </table>\n</div>"
